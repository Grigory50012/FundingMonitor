<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true" internalLogLevel="Warn" internalLogToConsoleError="true">
  <variable name="logDirectory" value="${basedir}/logs/api-host" />
  <targets>
    <target xsi:type="AsyncWrapper" name="file" queueLimit="10000" overflowAction="Discard">
      <target xsi:type="File" name="jsonFile" fileName="${var:logDirectory}/app.jsonl"
              archiveEvery="Day" archiveAboveSize="20971520" archiveSuffixFormat="_{0:000}"
              maxArchiveFiles="20" maxArchiveDays="7">
        <layout xsi:type="JsonLayout" includeEventProperties="true" includeScopeProperties="true">
          <attribute name="Timestamp" layout="${date:universalTime=true:format=o}" />
          <attribute name="Level" layout="${level}" />
          <attribute name="Category" layout="${logger}" />
          <attribute name="Message" layout="${message}" />
          <attribute name="MessageTemplate" layout="${message:raw=true}" />
          <attribute name="Exception" layout="${exception:format=tostring}" includeEmptyValue="false" />
        </layout>
      </target>
    </target>
    <target xsi:type="Console" name="console" layout="${date:format=HH\:mm\:ss}|${level:uppercase=true}|${logger:shortName=true}|${message} ${exception:format=message}" />
  </targets>
  <rules>
    <!-- Add a module-specific Debug rule before these rules when diagnosing an issue. -->
    <logger name="FundingMonitor.*" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="DatabaseMigrator*" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.Migrations" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="*" minlevel="Warn" writeTo="file,console" />
  </rules>
</nlog>
