<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9"/>
        <PackageReference Include="Microsoft.OpenApi" Version="2.10.0"/>
        <PackageReference Include="NLog" Version="6.1.4"/>
        <PackageReference Include="NLog.Web.AspNetCore" Version="6.1.4"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.11"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Modules\ExchangeIntegration\FundingMonitor.ExchangeIntegration.Presentation\FundingMonitor.ExchangeIntegration.Presentation.csproj"/>
        <ProjectReference Include="..\Modules\CurrentRates\FundingMonitor.CurrentRates.Presentation\FundingMonitor.CurrentRates.Presentation.csproj"/>
        <ProjectReference Include="..\Modules\HistoricalRates\FundingMonitor.HistoricalRates.Presentation\FundingMonitor.HistoricalRates.Presentation.csproj"/>
        <ProjectReference Include="..\Modules\Arbitrage\FundingMonitor.Arbitrage.Presentation\FundingMonitor.Arbitrage.Presentation.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../Logging/LocalLogging.cs" Link="Logging/LocalLogging.cs" />
        <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
